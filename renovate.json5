{
  // Docs: https://docs.renovatebot.com/configuration-options

  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'github>glitch452/renovate-config',
    'github>glitch452/renovate-config//presets/github-action',
    'github>glitch452/renovate-config//presets/npm',
  ],

  // Run on Friday Mornings
  schedule: ['* 0-6 * * 5'],

  packageRules: [
    // Ignore these. Keep them at the end of the packageRules to maintain precedence.
    {
      enabled: false,
      matchManagers: ['npm'],
      matchUpdateTypes: ['major'],
      matchPackageNames: ['eslint'],
    },
  ],
}
